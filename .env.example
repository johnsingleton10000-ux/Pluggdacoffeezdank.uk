# Public site URL used for auth redirects and later checkout callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required for authentication and the account foundation)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a later ecommerce stage. Not used by the foundation.
STRIPE_SECRET_KEY=
